# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored. Never commit real values.

# --- Django -------------------------------------------------------------
# Signs login tokens and sessions. Use a long random value (at least 32 characters).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# True for local development only. Leave False anywhere real people can reach it.
DJANGO_DEBUG=True

# Hostnames the site may be served from, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Set to True once the site is served over HTTPS (secure cookies, redirect, HSTS).
DJANGO_HTTPS=False

# --- Database -----------------------------------------------------------
# The postgres container is created with these, so pick your own values.
# NOTE: the password is only applied the first time the database volume is created.
# To change it later, change it inside Postgres too (or remove the volume and start fresh).
DB_NAME=infra_db
DB_USER=infra_user
DB_PASSWORD=choose-a-strong-password
DB_HOST=db
DB_PORT=5432

# --- Frontend -----------------------------------------------------------
# Where the browser reaches the API.
VITE_API_BASE_URL=http://localhost:8000/api/v1
